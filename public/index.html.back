<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VN Studio</title>
<style>
  :root{ --ink:#efe7d6; --bg:#161221; --panel:#1f1a2e; --panel-edge:#3a3153; --gold:#c9a24b; --rose:#b0658a; --dim:#a79bc2; }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0;overflow:hidden}
  body{background:var(--bg);color:var(--ink);font-family:-apple-system,Segoe UI,Roboto,sans-serif}

  #topbar{
    position:fixed; top:0; left:0; right:0; height:48px; z-index:30;
    background:#12101c; border-bottom:1px solid var(--panel-edge);
    display:flex; align-items:center; gap:8px; padding:0 14px;
    padding-top:env(safe-area-inset-top,0px); height:calc(48px + env(safe-area-inset-top,0px));
  }
  #topbar h1{font-size:13px; font-family:Georgia,serif; font-style:italic; color:var(--rose); margin:0 10px 0 0; font-weight:normal}
  .tab{background:transparent; border:1px solid var(--panel-edge); color:var(--dim); border-radius:6px; padding:6px 14px; cursor:pointer; font-size:13px}
  .tab.active{color:var(--gold); border-color:var(--gold)}

  #playerView, #editorView{ position:fixed; top:calc(48px + env(safe-area-inset-top,0px)); left:0; right:0; bottom:0; }
  #editorView{display:none}
  /* Чистая игра без панелей (публикация /play/...) */
  body.clean-play #topbar{ display:none !important; }
  body.clean-play #loadBtn{ display:none !important; }
  body.clean-play #playerView{
    top:0 !important;
    height:100% !important;
  }
  body.clean-play #hint{ display:none !important; }

  #editorFrame{width:100%; height:100%; border:0; background:#161221}

  #stage{ position:relative; width:100%; height:100%; background-size:cover; background-position:center; background-repeat:no-repeat; background-color:#241c38; transition:background-color .35s ease; }
  #sprites{position:absolute; inset:0; pointer-events:none;}
  .sprite{
    position:absolute; bottom:0;
    width:28%; max-width:none; height:auto; max-height:85%;
    --sx:1;
    filter:drop-shadow(0 20px 30px rgba(0,0,0,.5));
    font-size:120px; text-align:center; line-height:1;
    opacity:0; display:flex; align-items:center; justify-content:center;
    transform-origin:center center; box-sizing:border-box;
    transform:translateX(-50%) scale(var(--sx));
  }
  .sprite.show{opacity:1}
  .sprite.floor{align-items:flex-end; transform-origin:center bottom}
  .sprite.left{left:20%; transform:translateX(-50%)}
  .sprite.center{left:50%; transform:translateX(-50%)}
  .sprite.right{left:80%; transform:translateX(-50%)}
  .sprite img{
    width:100%; height:auto; max-height:100%;
    object-fit:contain; object-position:bottom center; display:block;
  }
  .sprite.in-fade{ animation: sprInFade .45s ease forwards; }
  .sprite.in-slide-left{ animation: sprInSL .45s ease forwards; }
  .sprite.in-slide-right{ animation: sprInSR .45s ease forwards; }
  .sprite.in-slide-up{ animation: sprInSU .45s ease forwards; }
  .sprite.in-slide-down{ animation: sprInSD .45s ease forwards; }
  .sprite.out-fade{ animation: sprOutFade .35s ease forwards; }
  .sprite.out-slide-left{ animation: sprOutSL .35s ease forwards; }
  .sprite.out-slide-right{ animation: sprOutSR .35s ease forwards; }
  .sprite.out-slide-up{ animation: sprOutSU .35s ease forwards; }
  .sprite.out-slide-down{ animation: sprOutSD .35s ease forwards; }
  @keyframes sprInFade{ from{opacity:0} to{opacity:1} }
  @keyframes sprInSL{ from{opacity:0; transform:translateX(calc(-50% - 70px)) scale(var(--sx))} to{opacity:1; transform:translateX(-50%) scale(var(--sx))} }
  @keyframes sprInSR{ from{opacity:0; transform:translateX(calc(-50% + 70px)) scale(var(--sx))} to{opacity:1; transform:translateX(-50%) scale(var(--sx))} }
  @keyframes sprInSU{ from{opacity:0; transform:translateX(-50%) translateY(50px) scale(var(--sx))} to{opacity:1; transform:translateX(-50%) scale(var(--sx))} }
  @keyframes sprInSD{ from{opacity:0; transform:translateX(-50%) translateY(-40px) scale(var(--sx))} to{opacity:1; transform:translateX(-50%) scale(var(--sx))} }
  @keyframes sprOutFade{ from{opacity:1} to{opacity:0} }
  @keyframes sprOutSL{ from{opacity:1; transform:translateX(-50%) scale(var(--sx))} to{opacity:0; transform:translateX(calc(-50% - 70px)) scale(var(--sx))} }
  @keyframes sprOutSR{ from{opacity:1; transform:translateX(-50%) scale(var(--sx))} to{opacity:0; transform:translateX(calc(-50% + 70px)) scale(var(--sx))} }
  @keyframes sprOutSU{ from{opacity:1; transform:translateX(-50%) scale(var(--sx))} to{opacity:0; transform:translateX(-50%) translateY(-40px) scale(var(--sx))} }
  @keyframes sprOutSD{ from{opacity:1; transform:translateX(-50%) scale(var(--sx))} to{opacity:0; transform:translateX(-50%) translateY(50px) scale(var(--sx))} }
  #gameMenu{
    display:none; position:absolute; inset:0; z-index:40;
    background:#120f1a center/cover no-repeat;
    flex-direction:column; align-items:center; justify-content:center;
    padding:24px; text-align:center;
  }
  #gameMenu.open{display:flex}
  #gameMenu .gm-scrim{position:absolute;inset:0;background:rgba(10,8,16,.55);pointer-events:none}
  #gameMenu .gm-inner{position:relative;z-index:1;width:min(360px,92%)}
  #gameMenu .gm-title{
    font-family:Georgia,serif; font-style:italic; font-size:clamp(1.6rem,4vw,2.2rem);
    color:var(--gold); margin:0 0 10px; text-shadow:0 4px 24px rgba(0,0,0,.6);
  }
  #gameMenu .gm-desc{
    font-size:14px; color:var(--dim); line-height:1.5; margin:0 0 22px;
    max-height:4.5em; overflow:hidden;
  }
  #gameMenu .gm-btn{
    display:block; width:100%; margin:0 0 10px; padding:14px 18px;
    background:var(--panel); border:1px solid var(--panel-edge); color:var(--ink);
    border-radius:10px; font-size:15px; cursor:pointer;
  }
  #gameMenu .gm-btn:hover{border-color:var(--gold); color:var(--gold)}
  #gameMenu .gm-btn.primary{background:rgba(201,162,75,.15); border-color:var(--gold); color:var(--gold)}
  #gameMenu .gm-sub{font-size:12px; color:var(--dim); margin-top:8px}
  #pauseBtn{
    display:none; position:absolute; top:12px; right:12px; z-index:30;
    background:rgba(20,16,28,.75); border:1px solid var(--panel-edge); color:var(--ink);
    border-radius:8px; padding:8px 12px; cursor:pointer; font-size:13px;
  }
  #pauseBtn.show{display:block}
  #box{ position:absolute; left:50%; bottom:env(safe-area-inset-bottom,0px); transform:translateX(-50%); width:min(760px,92%); margin-bottom:24px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:10px; padding:18px 22px 20px; cursor:pointer; user-select:none; box-shadow:0 12px 40px rgba(0,0,0,.45); }
  #name{ font-family:Georgia,'Times New Roman',serif; font-style:italic; color:var(--rose); font-size:15px; margin-bottom:6px; min-height:1em; }
  #text{font-size:16.5px; line-height:1.55; min-height:64px}
  #continue{text-align:right; color:var(--dim); font-size:12px; margin-top:6px; opacity:.8;}
  #choices{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); display:flex; flex-direction:column; gap:12px; width:min(520px,86%); }
  .choice{ background:var(--panel); border:1px solid var(--panel-edge); color:var(--ink); padding:14px 18px; border-radius:8px; font-size:15px; cursor:pointer; text-align:left; }
  .choice:hover{border-color:var(--gold); color:var(--gold)}

  #box.narration{
    top:50%; bottom:auto; transform:translate(-50%,-50%);
    background:rgba(15,12,24,.55); border-color:transparent; box-shadow:none;
    text-align:center;
  }
  #box.narration #name{display:none}
  #box.narration #text{font-family:Georgia,'Times New Roman',serif; font-style:italic; font-size:19px}
  #box.narration #continue{text-align:center}

  #loadBtn{ position:absolute; top:14px; left:14px; z-index:5; background:var(--panel); border:1px solid var(--panel-edge); color:var(--dim); border-radius:6px; padding:7px 12px; font-size:12.5px; cursor:pointer; }
  #loadBtn:hover{border-color:var(--gold); color:var(--gold)}
  #loadPanel{ display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:20; align-items:center; justify-content:center; }
  #loadPanel .inner{ background:var(--panel); border:1px solid var(--panel-edge); border-radius:10px; padding:16px; width:min(500px,92%); }
  #loadPanel textarea{ width:100%; height:260px; background:#0f0c18; color:var(--ink); border:1px solid var(--panel-edge); border-radius:6px; padding:8px; font-family:monospace; font-size:11.5px; resize:vertical; }
  #loadPanel .row{display:flex; gap:8px; margin-top:8px}
  #loadPanel button{ background:#0f0c18; border:1px solid var(--panel-edge); color:var(--ink); border-radius:6px; padding:7px 12px; cursor:pointer; font-size:13px; }
  #loadPanel button:hover{border-color:var(--gold); color:var(--gold)}

  #bootOverlay{
    position:absolute; inset:0; z-index:30; background:#0c0a14;
    display:none; flex-direction:column; align-items:center; justify-content:center;
    gap:14px; transition:opacity .35s ease; opacity:1;
  }
  #bootOverlay.show{ display:flex; }
  #bootOverlay.hidden{ opacity:0; pointer-events:none; }
  #bootOverlay .boot-title{ font-family:Georgia,serif; font-style:italic; color:var(--rose); font-size:18px; }
  #bootOverlay .boot-bar{
    width:min(320px,70%); height:6px; background:#1f1a2e; border-radius:4px; overflow:hidden;
    border:1px solid var(--panel-edge);
  }
  #bootOverlay .boot-fill{
    height:100%; width:0%; background:linear-gradient(90deg,var(--rose),var(--gold));
    transition:width .15s ease;
  }
  #bootOverlay .boot-status{ font-size:12px; color:var(--dim); max-width:80%; text-align:center; }

  #loadPanel p{font-size:12px; color:var(--dim); margin:0 0 8px}
  #hint{color:var(--dim); font-size:12px; margin-left:auto}
</style>
</head>
<body>

<div id="topbar">
  <h1>VN Studio</h1>
  <button class="tab active" id="tabPlayer">▶ Плеер</button>
  <button class="tab" id="tabEditor">🧩 Редактор</button>
  <span id="hint">Соберите схему в «Редактор» → «Экспорт JSON» → скопируйте → «Плеер» → «Загрузить сценарий»</span>
</div>

<div id="playerView">
  <div id="bootOverlay" style="display:none">
    <div class="boot-title">Загрузка…</div>
    <div class="boot-bar"><div class="boot-fill" id="bootFill"></div></div>
    <div class="boot-status" id="bootStatus">Подготовка ассетов</div>
  </div>
  <div id="stage">
    <button id="loadBtn">📂 Загрузить сценарий</button>
    <button type="button" id="pauseBtn" title="Меню (Esc)">☰</button>
    <div id="gameMenu">
      <div class="gm-scrim"></div>
      <div class="gm-inner">
        <h1 class="gm-title" id="gmTitle">Новелла</h1>
        <p class="gm-desc" id="gmDesc"></p>
        <button type="button" class="gm-btn primary" id="gmNew">Новая игра</button>
        <button type="button" class="gm-btn" id="gmSettings" style="display:none">Настройки</button>
        <div id="gmSettingsPanel" style="display:none;text-align:left;margin:12px 0;padding:12px;background:rgba(0,0,0,.25);border-radius:8px">
          <label style="font-size:12px;color:var(--dim)">Громкость <span id="gmVolLbl">100</span>%</label>
          <input type="range" id="gmVol" min="0" max="100" value="100" style="width:100%">
        </div>
        <button type="button" class="gm-btn" id="gmResume" style="display:none">Продолжить</button>
        <button type="button" class="gm-btn" id="gmToTitle" style="display:none">В главное меню</button>
        <p class="gm-sub" id="gmHint"></p>
      </div>
    </div>
    <div id="sprites"></div>
    <div id="choices" style="display:none"></div>
    <div id="box">
      <div id="name"></div>
      <div id="text"></div>
      <div id="continue">нажмите, чтобы продолжить ▾</div>
    </div>
  </div>
  <div id="loadPanel">
    <div class="inner">
      <p>Вставьте JSON, экспортированный из редактора, и запустите его.</p>
      <textarea id="loadArea" placeholder="[{&quot;id&quot;:&quot;start&quot;, ...}]"></textarea>
      <div class="row">
        <button id="runBtn">▶ Запустить</button>
        <button id="cancelBtn">Отмена</button>
      </div>
    </div>
  </div>
</div>

<div id="editorView">
  <iframe id="editorFrame"></iframe>
</div>

<script>
/* ---------- вкладки ---------- */
const tabPlayer = document.getElementById('tabPlayer');
const tabEditor = document.getElementById('tabEditor');

/** Режим «только игра» — без топбара и кнопки загрузки */
function enableCleanPlay(){
  document.body.classList.add('clean-play');
  const lb = document.getElementById('loadBtn');
  if(lb) lb.style.display = 'none';
  const tb = document.getElementById('topbar');
  if(tb) tb.style.display = 'none';
  const pv = document.getElementById('playerView');
  if(pv){ pv.style.top = '0'; pv.style.display = 'block'; }
  const ev = document.getElementById('editorView');
  if(ev) ev.style.display = 'none';
}
(function detectCleanPlay(){
  const q = new URLSearchParams(location.search);
  if(window.__VN_PROJECT__ || window.__VN_PROJECT_ID__ || q.get('play') === '1' || q.get('clean') === '1'){
    enableCleanPlay();
  }
})();

const playerView = document.getElementById('playerView');
const editorView = document.getElementById('editorView');
let editorLoaded = false;

tabPlayer.addEventListener('click', () => {
  tabPlayer.classList.add('active'); tabEditor.classList.remove('active');
  playerView.style.display = 'block'; editorView.style.display = 'none';
});
tabEditor.addEventListener('click', () => {
  tabEditor.classList.add('active'); tabPlayer.classList.remove('active');
  editorView.style.display = 'block'; playerView.style.display = 'none';
  if(!editorLoaded){
    const bytes = Uint8Array.from(atob(EDITOR_HTML_B64), c => c.charCodeAt(0));
    document.getElementById('editorFrame').srcdoc = new TextDecoder('utf-8').decode(bytes);
    editorLoaded = true;
  }
});

/* ---------- движок (VNEngine) ---------- */


/* ---------- Audio (Web Audio API) ---------- */
const AudioBus = {
  ctx: null,
  master: null,
  buffers: new Map(), // url -> AudioBuffer
  bgmSource: null,
  bgmGain: null,
  bgmUrl: null,
  unlocked: false,

  async ensure(){
    if(!this.ctx){
      const AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return null;
      this.ctx = new AC();
      this.master = this.ctx.createGain();
      this.master.gain.value = 1;
      this.master.connect(this.ctx.destination);
    }
    if(this.ctx.state === 'suspended'){
      try { await this.ctx.resume(); } catch(_){}
    }
    this.unlocked = true;
    return this.ctx;
  },

  isAudioUrl(url){
    if(!url || typeof url !== 'string' || url.startsWith('#')) return false;
    return /\.(mp3|ogg|wav|m4a|aac|webm|flac)(\?|$)/i.test(url)
      || url.startsWith('data:audio')
      || url.startsWith('blob:');
  },

  async load(url){
    if(!url) return null;
    if(this.buffers.has(url)) return this.buffers.get(url);
    await this.ensure();
    if(!this.ctx) return null;
    try{
      const ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      const timer = setTimeout(() => { try{ ctrl && ctrl.abort(); }catch(_){} }, 7000);
      const res = await fetch(url, ctrl ? { signal: ctrl.signal, mode: 'cors' } : { mode: 'cors' });
      clearTimeout(timer);
      if(!res.ok) throw new Error('HTTP ' + res.status);
      const arr = await res.arrayBuffer();
      const buf = await this.ctx.decodeAudioData(arr.slice(0));
      this.buffers.set(url, buf);
      return buf;
    }catch(e){
      console.warn('Audio WebAudio load failed (CORS/timeout?)', url, e && e.message);
      this.buffers.set(url, null); // mark failed so we don't retry forever
      return null;
    }
  },

  async preload(urls, onProgress){
    const list = [...new Set((urls||[]).filter(u => this.isAudioUrl(u)))];
    let done = 0;
    for(const url of list){
      try {
        await Promise.race([
          this.load(url),
          new Promise(r => setTimeout(r, 7500))
        ]);
      } catch(_){}
      done++;
      if(onProgress) onProgress(done, list.length, url);
    }
  },

  _htmlBgm: null,
  _htmlBgmUrl: null,

  stopHtmlBgm(){
    if(this._htmlBgm){
      try { this._htmlBgm.pause(); this._htmlBgm.src = ''; } catch(_){}
      this._htmlBgm = null;
      this._htmlBgmUrl = null;
    }
  },

  playHtmlBgm(url, vol){
    if(this._htmlBgmUrl === url && this._htmlBgm && !this._htmlBgm.paused){
      this._htmlBgm.volume = Math.max(0, Math.min(1, vol));
      return;
    }
    this.stopHtmlBgm();
    const a = new Audio();
    a.loop = true;
    a.preload = 'auto';
    a.volume = Math.max(0, Math.min(1, vol));
    a.src = url;
    const p = a.play();
    if(p && p.catch) p.catch(err => console.warn('HTMLAudio BGM play blocked', err));
    this._htmlBgm = a;
    this._htmlBgmUrl = url;
  },

  playHtmlSfx(url, vol){
    const a = new Audio();
    a.volume = Math.max(0, Math.min(1, vol != null ? Number(vol) : 1));
    a.src = url;
    const p = a.play();
    if(p && p.catch) p.catch(() => {});
  },

  async playBgm(url, opts){
    opts = opts || {};
    if(!url){ await this.stopBgm(opts.fade); return; }
    const wantVol = opts.volume != null ? Number(opts.volume) : 0.55;
    if(this.bgmUrl === url && this.bgmSource){
      if(this.bgmGain){
        try { this.bgmGain.gain.setTargetAtTime(wantVol, this.ctx.currentTime, 0.05); }
        catch(_){ this.bgmGain.gain.value = wantVol; }
      }
      return;
    }
    if(this._htmlBgmUrl === url && this._htmlBgm){
      this._htmlBgm.volume = Math.max(0, Math.min(1, wantVol));
      return;
    }
    await this.ensure();
    // try WebAudio first (works for same-origin / CORS-enabled)
    const buf = await this.load(url);
    if(buf && this.ctx){
      this.stopHtmlBgm();
      await this.stopBgm(opts.fade != null ? opts.fade : 0.35);
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      src.loop = opts.loop !== false;
      const g = this.ctx.createGain();
      g.gain.value = 0;
      src.connect(g);
      g.connect(this.master || this.ctx.destination);
      try { src.start(0); } catch(_){}
      const now = this.ctx.currentTime;
      const fade = opts.fade != null ? opts.fade : 0.5;
      try {
        g.gain.linearRampToValueAtTime(wantVol, now + Math.max(0.05, fade));
      } catch(_){ g.gain.value = wantVol; }
      this.bgmSource = src;
      this.bgmGain = g;
      this.bgmUrl = url;
      src.onended = () => {
        if(this.bgmSource === src){ this.bgmSource = null; this.bgmUrl = null; }
      };
      return;
    }
    // Fallback: HTMLAudio (many CDNs allow <audio> without CORS for WebAudio)
    await this.stopBgm(0.2);
    this.playHtmlBgm(url, wantVol);
    this.bgmUrl = url;
  },

  async stopBgm(fade){
    this.stopHtmlBgm();
    const src = this.bgmSource;
    const g = this.bgmGain;
    this.bgmSource = null;
    this.bgmGain = null;
    this.bgmUrl = null;
    if(!src) return;
    try{
      if(g && this.ctx && fade){
        const now = this.ctx.currentTime;
        g.gain.cancelScheduledValues(now);
        g.gain.setValueAtTime(g.gain.value, now);
        g.gain.linearRampToValueAtTime(0.001, now + fade);
        setTimeout(() => { try{ src.stop(); }catch(_){} }, fade * 1000 + 30);
      } else {
        try{ src.stop(); }catch(_){}
      }
    }catch(_){}
  },

  async playSfx(url, vol){
    if(!url) return;
    await this.ensure();
    const buf = await this.load(url);
    if(buf && this.ctx){
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      const g = this.ctx.createGain();
      g.gain.value = vol != null ? Number(vol) : 1;
      src.connect(g);
      g.connect(this.master || this.ctx.destination);
      try { src.start(0); } catch(_){}
      return;
    }
    this.playHtmlSfx(url, vol);
  },

  stopAll(){
    this.stopBgm(0);
  }
};

// unlock on first gesture
['pointerdown','keydown','touchstart'].forEach(ev => {
  window.addEventListener(ev, () => {
    AudioBus.ensure().then(() => {
      try { if(AudioBus.ctx && AudioBus.ctx.state === 'suspended') AudioBus.ctx.resume(); } catch(_){}
      // resume HTML BGM if browser blocked autoplay
      if(AudioBus._htmlBgm && AudioBus._htmlBgm.paused){
        AudioBus._htmlBgm.play().catch(()=>{});
      }
    });
  }, { once: false, passive: true });
});


/* ---------- Asset cache / preload ---------- */
const AssetCache = {
  map: new Map(), // url -> HTMLImageElement | true
  async preload(urls, onProgress){
    const list = [...new Set((urls||[]).filter(u => u && typeof u === 'string' && !u.startsWith('#')))];
    // data: and blob: still decode once so first paint is warm
    let done = 0;
    const total = Math.max(list.length, 1);
    const tick = (url) => {
      done++;
      if(onProgress) onProgress(done, list.length, url);
    };
    if(!list.length){
      if(onProgress) onProgress(1, 1, '');
      return;
    }
    await Promise.all(list.map(url => new Promise(resolve => {
      if(this.map.has(url)){ tick(url); resolve(); return; }
      let settled = false;
      const done = (val) => {
        if(settled) return;
        settled = true;
        this.map.set(url, val);
        tick(url);
        resolve();
      };
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => done(img);
      img.onerror = () => done(null);
      const t = setTimeout(() => done(null), 8000);
      img.onload = () => { clearTimeout(t); done(img); };
      img.onerror = () => { clearTimeout(t); done(null); };
      try { img.src = url; } catch(_){ clearTimeout(t); done(null); }
    })));
  },
  has(url){ return this.map.has(url) && this.map.get(url); },
  get(url){ return this.map.get(url); }
};

function isLoadableMediaUrl(u){
  if(!u || typeof u !== 'string') return false;
  u = u.trim();
  if(!u || u.startsWith('#')) return false;
  // CSS colors / short tokens
  if(/^(rgb|hsl)a?\(/i.test(u)) return false;
  if(/^[a-z]+$/i.test(u) && u.length < 20) return false; // "cover", "center", asset ids without path
  if(u.startsWith('data:') || u.startsWith('blob:') || u.startsWith('http://') || u.startsWith('https://')) return true;
  // relative path with media extension or /assets/
  if(/\.(png|jpe?g|gif|webp|svg|mp3|ogg|wav|m4a|aac|flac|webm)(\?|$)/i.test(u)) return true;
  if(u.startsWith('/') || u.startsWith('./') || u.startsWith('../')) return true;
  return false;
}
function collectAssetUrls(data){
  const urls = [];
  const add = (u) => { if(isLoadableMediaUrl(u)) urls.push(u); };
  if(!data) return urls;
  const nodes = Array.isArray(data) ? data : (data.nodes || []);
  (data.assets || []).forEach(a => add(a.src || a.url));
  (data.scenes || []).forEach(s => {
    add(s.bg);
    add(s.bgm || s.music);
  });
  nodes.forEach(n => {
    add(n.bg);
    add(n.bgm || n.music);
    add(n.sfx);
    (n.sprites||[]).forEach(s => add(s.src));
    (n.choices||[]).forEach(c => {
      add(c.sfx);
      (c.effects||[]).forEach(e => { if(e.sfx) add(e.sfx); if(e.type==='sfx' && e.src) add(e.src); });
    });
  });
  return urls;
}

function splitMediaUrls(urls){
  const images = [], audio = [];
  (urls||[]).forEach(u => {
    if(AudioBus.isAudioUrl(u)) audio.push(u);
    else images.push(u);
  });
  return { images, audio };
}

function setBootProgress(loaded, total, url){
  const fill = document.getElementById('bootFill');
  const st = document.getElementById('bootStatus');
  const ov = document.getElementById('bootOverlay');
  if(!ov) return;
  // не поднимаем оверлей сами — только showBoot()
  if(ov.style.display === 'none' && !ov.classList.contains('show')) return;
  ov.classList.add('show');
  ov.classList.remove('hidden');
  ov.style.display = 'flex';
  const pct = total ? Math.round((loaded / total) * 100) : 100;
  if(fill) fill.style.width = pct + '%';
  if(st){
    const name = url ? url.split('/').pop().split('?')[0].slice(0, 40) : '';
    st.textContent = total ? ('Ассеты ' + loaded + '/' + total + (name ? ' · ' + name : '')) : 'Готово';
  }
}
function hideBoot(){
  const ov = document.getElementById('bootOverlay');
  if(!ov) return;
  ov.classList.add('hidden');
  ov.classList.remove('show');
  setTimeout(() => {
    ov.style.display = 'none';
    ov.classList.remove('show');
  }, 200);
}
function showBoot(){
  const ov = document.getElementById('bootOverlay');
  if(!ov) return;
  ov.style.display = 'flex';
  ov.classList.add('show');
  ov.classList.remove('hidden');
  const fill = document.getElementById('bootFill');
  if(fill) fill.style.width = '0%';
  const st = document.getElementById('bootStatus');
  if(st) st.textContent = 'Подготовка ассетов';
}


/* ---------- Preview from editor (postMessage) ---------- */
let __previewStarted = false;
let __previewBusy = false;
window.addEventListener('message', async (e) => {
  const msg = e.data;
  if(!msg || msg.type !== 'vn-preview') return;
  if(!msg.project || !msg.project.nodes) return;
  // повторные копии того же сообщения — только ack
  if(__previewBusy){
    try { if(e.source) e.source.postMessage({ type: 'vn-preview-ack' }, '*'); } catch(_){}
    return;
  }
  if(__previewStarted){
    try { if(e.source) e.source.postMessage({ type: 'vn-preview-ack' }, '*'); } catch(_){}
    return;
  }
  __previewBusy = true;
  try{
    if(typeof enableCleanPlay === 'function') enableCleanPlay();
    else document.body.classList.add('clean-play');
    const startId = msg.startId || (msg.project.nodes[0] && msg.project.nodes[0].id) || null;
    console.log('[vn-preview] start', startId, 'nodes', msg.project.nodes.length);
    await startGame(msg.project, startId);
    __previewStarted = true;
    try { if(e.source) e.source.postMessage({ type: 'vn-preview-ack' }, '*'); } catch(_){}
  }catch(err){
    console.error('preview failed', err);
  }finally{
    __previewBusy = false;
  }
});
function __signalPreviewReady(){
  try {
    if(window.parent && window.parent !== window){
      window.parent.postMessage({ type: 'vn-preview-ready' }, '*');
    }
  } catch(_){}
}
__signalPreviewReady();
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', __signalPreviewReady);
} else {
  setTimeout(__signalPreviewReady, 0);
}



function applyUiTheme(theme){
  if(!theme || typeof theme !== 'object') return;
  const box = document.getElementById('box');
  const name = document.getElementById('name');
  const text = document.getElementById('text');
  const d = theme.dialogue || {};
  const c = theme.choice || {};
  if(box){
    if(d.bg) box.style.background = d.bg;
    if(d.color) box.style.color = d.color;
    if(d.radius != null) box.style.borderRadius = (typeof d.radius === 'number' ? d.radius + 'px' : d.radius);
  }
  if(name && d.speakerColor) name.style.color = d.speakerColor;
  if(text && d.color) text.style.color = d.color;
  // choice buttons created dynamically — set CSS vars
  const root = document.getElementById('stage') || document.documentElement;
  if(c.bg) root.style.setProperty('--choice-bg', c.bg);
  if(c.color) root.style.setProperty('--choice-color', c.color);
  if(c.radius != null) root.style.setProperty('--choice-radius', (typeof c.radius === 'number' ? c.radius + 'px' : String(c.radius)));
}

let __menuProject = null;
let __menuStartId = null;
let __menuMode = 'title'; // title | pause

function showGameMenu(mode, data, startId){
  __menuMode = mode || 'title';
  if(data) __menuProject = data;
  if(startId !== undefined) __menuStartId = startId;
  const data0 = __menuProject;
  if(!data0) return;
  const menuCfg = Object.assign({ enabled: true, showOnStart: true, bg: '' }, data0.menu || {});
  const el = document.getElementById('gameMenu');
  if(!el) return;
  const title = data0.title || 'Новелла';
  document.getElementById('gmTitle').textContent = title;
  document.getElementById('gmDesc').textContent = (data0.description || '').trim();
  const bg = menuCfg.bg || data0.coverUrl || '';
  el.style.backgroundImage = bg ? ('url("' + String(bg).replace(/"/g,'\\"') + '")') : 'none';
  el.style.backgroundColor = '#120f1a';
  const isPause = __menuMode === 'pause';
  document.getElementById('gmNew').style.display = isPause ? 'none' : 'block';
  document.getElementById('gmResume').style.display = isPause ? 'block' : 'none';
  document.getElementById('gmToTitle').style.display = isPause ? 'block' : 'none';
  document.getElementById('gmHint').textContent = isPause ? 'Пауза' : 'Титульный экран';
  el.classList.add('open');
  const pb = document.getElementById('pauseBtn');
  if(pb) pb.classList.remove('show');
}

function hideGameMenu(){
  document.getElementById('gameMenu')?.classList.remove('open');
  const pb = document.getElementById('pauseBtn');
  if(pb && __menuProject) pb.classList.add('show');
}

function beginPlayFromMenu(){
  hideGameMenu();
  const data = __menuProject;
  if(!data) return;
  applyUiTheme(data.uiTheme);
  // re-enter engine without menu
  try{
    if(typeof engine !== 'undefined' && engine){
      if(engine._t) clearInterval(engine._t);
      if(typeof AudioBus !== 'undefined') AudioBus.stopAll();
      engine = null;
    }
  }catch(_){}
  try{
    document.getElementById('sprites').innerHTML = '';
    document.getElementById('stage').style.background = '#241c38';
    document.getElementById('stage').style.backgroundImage = 'none';
    engine = new VNEngine(data, __menuStartId || undefined);
  }catch(e){ console.error(e); }
}

function bindGameMenuOnce(){
  if(window.__VN_MENU_BOUND__) return;
  window.__VN_MENU_BOUND__ = true;
  document.getElementById('gmNew')?.addEventListener('click', () => beginPlayFromMenu());
  document.getElementById('gmResume')?.addEventListener('click', () => hideGameMenu());
  document.getElementById('gmToTitle')?.addEventListener('click', () => {
    if(!confirm('Вернуться в меню? Прогресс текущего прохождения не сохранится.')) return;
    try{
      if(engine && engine._t) clearInterval(engine._t);
      if(typeof AudioBus !== 'undefined') AudioBus.stopAll();
      engine = null;
    }catch(_){}
    document.getElementById('sprites').innerHTML = '';
    document.getElementById('choices').style.display = 'none';
    document.getElementById('box').style.display = 'none';
    showGameMenu('title');
  });
  document.getElementById('gmSettings')?.addEventListener('click', () => {
    const p = document.getElementById('gmSettingsPanel');
    if(p) p.style.display = p.style.display === 'none' ? 'block' : 'none';
  });
  document.getElementById('gmSettings').style.display = 'block';
  document.getElementById('gmVol')?.addEventListener('input', (e) => {
    const v = Number(e.target.value) / 100;
    document.getElementById('gmVolLbl').textContent = e.target.value;
    try{
      if(typeof AudioBus !== 'undefined'){
        if(AudioBus.setMasterVolume) AudioBus.setMasterVolume(v);
        else if(AudioBus.masterGain) AudioBus.masterGain.gain.value = v;
      }
    }catch(_){}
  });
  document.getElementById('pauseBtn')?.addEventListener('click', () => showGameMenu('pause'));
  document.addEventListener('keydown', (e) => {
    if(e.key !== 'Escape') return;
    const menu = document.getElementById('gameMenu');
    if(!menu || !__menuProject) return;
    if(menu.classList.contains('open') && __menuMode === 'pause') hideGameMenu();
    else if(!menu.classList.contains('open') && engine) showGameMenu('pause');
  });
}
bindGameMenuOnce();

async function startGame(data, startId){
  // остановить предыдущий прогон (превью / повтор)
  try{
    if(typeof engine !== 'undefined' && engine){
      if(engine._t) clearInterval(engine._t);
      if(typeof AudioBus !== 'undefined') AudioBus.stopAll();
      engine = null;
    }
  }catch(_){}
  const urls = collectAssetUrls(data);
  const { images, audio } = splitMediaUrls(urls);
  const total = images.length + audio.length;
  if(total > 0){
    showBoot();
    let done = 0;
    const tick = (u) => {
      done++;
      setBootProgress(done, total, u || '');
    };
    setBootProgress(0, total, '');
    try{
      await Promise.race([
        (async () => {
          await AssetCache.preload(images, (d, t, u) => tick(u));
          await AudioBus.preload(audio, (d, t, u) => tick(u));
        })(),
        new Promise(r => setTimeout(r, 12000))
      ]);
    }catch(err){
      console.warn('preload', err);
    }
  } else {
    // нет ассетов — не показываем экран загрузки
    hideBoot();
  }
  try{
    document.getElementById('sprites').innerHTML = '';
    document.getElementById('stage').style.background = '#241c38';
    document.getElementById('stage').style.backgroundImage = 'none';
    applyUiTheme(data && data.uiTheme);
    const menuCfg = Object.assign({ enabled: true, showOnStart: true }, (data && data.menu) || {});
    const wantMenu = menuCfg.enabled !== false && menuCfg.showOnStart !== false && !startId;
    // preview with explicit startId skips title menu
    const isPreview = !!(window.__isPreview || new URLSearchParams(location.search).get('preview'));
    if(wantMenu && !isPreview){
      __menuProject = data;
      __menuStartId = startId || null;
      showGameMenu('title', data, startId);
      engine = null;
    } else {
      __menuProject = data;
      engine = new VNEngine(data, startId);
      document.getElementById('pauseBtn')?.classList.add('show');
    }
  } finally {
    hideBoot();
  }
  const lb = document.getElementById('loadBtn');
  if(lb) lb.style.display = 'none';
  return engine;
}


  const SPRITE_SLOTS = {
    'top-left':{x:18,y:62}, 'top':{x:50,y:62}, 'top-right':{x:82,y:62},
    'left':{x:18,y:38}, 'center':{x:50,y:38}, 'right':{x:82,y:38},
    'bottom-left':{x:18,y:0}, 'bottom':{x:50,y:0}, 'bottom-right':{x:82,y:0},
    'bl':{x:18,y:0}, 'bc':{x:50,y:0}, 'br':{x:82,y:0},
    'ml':{x:18,y:38}, 'mc':{x:50,y:38}, 'mr':{x:82,y:38},
    'tl':{x:18,y:62}, 'tc':{x:50,y:62}, 'tr':{x:82,y:62}
  };
  function slotXY(pos){
    return SPRITE_SLOTS[pos] || SPRITE_SLOTS['bottom'] || {x:50,y:0};
  }
  function isFloorAnchor(pos, y){
    if(pos === 'bottom' || pos === 'bottom-left' || pos === 'bottom-right' || pos === 'bl' || pos === 'bc' || pos === 'br')
      return true;
    if(pos && SPRITE_SLOTS[pos] && SPRITE_SLOTS[pos].y === 0) return true;
    if((pos == null || pos === 'custom') && y != null && Number(y) <= 4) return true;
    return false;
  }


function bgFitCss(fit){
  if(fit === 'contain') return 'contain';
  if(fit === 'fill' || fit === 'stretch') return '100% 100%';
  if(fit === 'actual' || fit === 'auto') return 'auto';
  return 'cover';
}
function applyStageBg(el, bg, fit, pos){
  if(!el) return;
  fit = fit || 'cover';
  pos = pos || 'center';
  if(!bg){
    el.style.background = '#241c38';
    el.style.backgroundImage = 'none';
    return;
  }
  if(String(bg).startsWith('#')){
    el.style.background = bg;
    el.style.backgroundImage = 'none';
    return;
  }
  el.style.backgroundColor = '#241c38';
  el.style.backgroundImage = 'url("' + String(bg).replace(/"/g, '\\"') + '")';
  el.style.backgroundSize = bgFitCss(fit);
  el.style.backgroundPosition = pos;
  el.style.backgroundRepeat = (fit === 'actual' || fit === 'auto') ? 'repeat' : 'no-repeat';
}
class VNEngine{
  constructor(script, startId){
    const data = Array.isArray(script) ? { nodes: script, variables: [] } : script;
    const list = data.nodes || [];
    this.script = Object.fromEntries(list.map(n=>[n.id,n]));
    this.startId = startId || (list[0] && list[0].id);
    this.projectAudio = {
      bgm: data.bgm || data.music || '',
      bgmVol: data.bgmVol != null ? data.bgmVol : 0.55,
      sfxVol: data.sfxVol != null ? data.sfxVol : 1,
      masterVol: data.masterVol != null ? data.masterVol : 1,
    };
    try {
      if(AudioBus.master) AudioBus.master.gain.value = Number(this.projectAudio.masterVol) || 1;
      else {
        AudioBus.ensure().then(() => {
          if(AudioBus.master) AudioBus.master.gain.value = Number(this.projectAudio.masterVol) || 1;
        });
      }
    } catch(_){}
    this.scenes = Object.create(null);
    (data.scenes || []).forEach(sc => { this.scenes[sc.id] = sc; });
    this.assets = Object.create(null);
    (data.assets || []).forEach(a => { if(a && a.id) this.assets[a.id] = a; });
    this.vars = {};
    this._bgm = null;
    (data.variables || []).forEach(v => {
      this.vars[v.id] = v.default !== undefined ? v.default : (v.type === 'bool' ? false : 0);
    });
    this.scenes = {};
    (data.scenes || []).forEach(s => { this.scenes[s.id] = s; });
    // map node -> scene via matching bg groups not available; layout from first scene with layout or node._sceneId
    this.nodeScene = {};
    (data.scenes || []).forEach(s => {
      // layout applied globally per scene id if nodes export sceneId - optional
    });
    this.defaultLayout = { box:{left:50,bottom:4,width:92}, choices:{left:50,top:42,width:56} };
    this.el = {
      stage: document.getElementById('stage'), sprites: document.getElementById('sprites'),
      name: document.getElementById('name'), text: document.getElementById('text'),
      box: document.getElementById('box'), choices: document.getElementById('choices'),
    };
    this.typing = false; this.spriteState = {}; this._displayText = '';
    this.el.box.addEventListener('click', ()=>this.onBoxClick());
    if(this.startId) this.goto(this.startId);
  }

  resolveAudio(ref){
    if(!ref) return '';
    if(typeof ref !== 'string') return '';
    if(ref.startsWith('/') || ref.startsWith('http') || ref.startsWith('data:') || ref.startsWith('blob:') || /\.\w{2,5}(\?|$)/.test(ref))
      return ref;
    const a = this.assets[ref];
    return a && a.src ? a.src : ref;
  }
  async applyAudio(node){
    const sc = node.sceneId && this.scenes[node.sceneId] ? this.scenes[node.sceneId] : null;
    const proj = this.projectAudio || {};
    // BGM cascade: node → scene → project
    // empty / missing on node = inherit; "none"|"stop" = stop
    const nodeBgm = (node.bgm != null && node.bgm !== '') ? node.bgm : (node.music != null && node.music !== '' ? node.music : null);
    const sceneBgm = sc ? ((sc.bgm != null && sc.bgm !== '') ? sc.bgm : (sc.music || null)) : null;
    const projectBgm = (proj.bgm != null && proj.bgm !== '') ? proj.bgm : null;

    let bgm = null;
    let vol = 0.55;
    let stop = false;
    if(nodeBgm === 'none' || nodeBgm === 'stop'){
      stop = true;
    } else if(nodeBgm){
      bgm = nodeBgm;
      vol = node.bgmVol != null ? Number(node.bgmVol) : (sc && sc.bgmVol != null ? Number(sc.bgmVol) : (proj.bgmVol != null ? Number(proj.bgmVol) : 0.55));
    } else if(sceneBgm === 'none' || sceneBgm === 'stop'){
      stop = true;
    } else if(sceneBgm){
      bgm = sceneBgm;
      vol = sc && sc.bgmVol != null ? Number(sc.bgmVol) : (proj.bgmVol != null ? Number(proj.bgmVol) : 0.55);
    } else if(projectBgm === 'none' || projectBgm === 'stop'){
      stop = true;
    } else if(projectBgm){
      bgm = projectBgm;
      vol = proj.bgmVol != null ? Number(proj.bgmVol) : 0.55;
    }

    if(stop){
      await AudioBus.stopBgm(0.5);
      this._bgm = null;
    } else if(bgm){
      const url = this.resolveAudio(bgm);
      await AudioBus.playBgm(url, { volume: vol, loop: true, fade: 0.7 });
      this._bgm = url;
    }
    // one-shot SFX on node enter
    const sfx = node.sfx || node.sound;
    if(sfx){
      const url = this.resolveAudio(sfx);
      const vol = node.sfxVol != null ? Number(node.sfxVol) : (proj.sfxVol != null ? Number(proj.sfxVol) : 1);
      AudioBus.playSfx(url, vol);
    }
  }

  check(cond){
    if(!cond) return true;
    // compound: all = AND, any = OR, not = negation
    if(Array.isArray(cond.all)) return cond.all.every(c => this.check(c));
    if(Array.isArray(cond.any)) return cond.any.some(c => this.check(c));
    if(cond.not) return !this.check(cond.not);
    if(!cond.var) return true;
    const left = this.vars[cond.var];
    let right = cond.value;
    const op = cond.op || 'eq';
    // coerce bool strings
    if(right === 'true') right = true;
    if(right === 'false') right = false;
    switch(op){
      case 'eq': return left == right;
      case 'neq': return left != right;
      case 'gt': return Number(left) > Number(right);
      case 'gte': return Number(left) >= Number(right);
      case 'lt': return Number(left) < Number(right);
      case 'lte': return Number(left) <= Number(right);
      default: return left == right;
    }
  }
    applyEffects(effects){
    if(!effects) return;
    effects.forEach(e => {
      if(!e.var) return;
      const op = e.op || 'set';
      if(op === 'set') this.vars[e.var] = e.value;
      else if(op === 'add') this.vars[e.var] = Number(this.vars[e.var]||0) + Number(e.value||0);
      else if(op === 'sub') this.vars[e.var] = Number(this.vars[e.var]||0) - Number(e.value||0);
      else if(op === 'toggle') this.vars[e.var] = !this.vars[e.var];
    });
  }
  resolveText(node){
    if(node.texts && node.texts.length){
      for(const t of node.texts){
        if(this.check(t.condition)) return t.text || '';
      }
      return node.texts[node.texts.length-1].text || node.text || '';
    }
    return node.text || '';
  }
  onBoxClick(){
    if(this.typing){ this.finishTyping(); return; }
    const node = this.current;
    if(!node) return;
    const visibleChoices = (node.choices||[]).filter(c => this.check(c.condition));
    if(visibleChoices.length) return;
    if(node.next) this.goto(node.next);
  }
  goto(id){
    let guard = 0;
    let node = this.script[id];
    while(node && node.condition && !this.check(node.condition) && guard++ < 50){
      id = node.next;
      node = id ? this.script[id] : null;
    }
    if(!node){ console.warn('Узел не найден:', id); return; }
    this.current = node;
    this.applyAudio(node);
    // сообщить редактору (превью) текущий блок/сцену
    try {
      if(window.parent && window.parent !== window){
        const sc = node.sceneId && this.scenes[node.sceneId] ? this.scenes[node.sceneId] : null;
        window.parent.postMessage({
          type: 'vn-preview-progress',
          nodeId: node.id,
          nodeTitle: node.title || node.id,
          sceneId: node.sceneId || null,
          sceneName: sc ? (sc.name || sc.id) : null,
          speaker: node.speaker || '',
          textPreview: String(node.text || '').slice(0, 80)
        }, '*');
      }
    } catch(_){}

    // UI layout: node → scene → default
    const scLay = (node.sceneId && this.scenes[node.sceneId] && this.scenes[node.sceneId].layout)
      ? this.scenes[node.sceneId].layout : null;
    const lay = node.layout || scLay || this.defaultLayout || {};
    const b = (lay && lay.box) ? lay.box : { left:50, bottom:4, width:92 };
    const c = (lay && lay.choices) ? lay.choices : { left:50, top:42, width:56 };
    const box = this.el.box;
    box.style.left = (b.left != null ? b.left : 50) + '%';
    box.style.bottom = (b.bottom != null ? b.bottom : 4) + '%';
    box.style.width = (b.width != null ? b.width : 92) + '%';
    box.style.maxWidth = 'none';
    box.style.top = 'auto';
    box.style.right = 'auto';
    box.style.transform = 'translateX(-50%)';
    box.style.marginBottom = '0';
    if(b.bg) box.style.background = b.bg;
    if(b.color) box.style.color = b.color;
    if(b.radius != null) box.style.borderRadius = b.radius + 'px';
    const rich = !!(b.name || b.text);
    box.classList.toggle('has-rich-layout', rich);
    if(b.padding != null) box.style.padding = rich ? '0' : (b.padding + 'px');
    else if(rich) box.style.padding = '0';
    const nameEl = this.el.name;
    const textEl = this.el.text;
    const applyText = (el, st, fallbackTop) => {
      if(!el || !st) return;
      if(st.x != null){ el.style.left = st.x + '%'; el.style.position = 'absolute'; }
      if(st.y != null){ el.style.top = st.y + '%'; el.style.position = 'absolute'; }
      if(st.fontSize) el.style.fontSize = st.fontSize + 'px';
      if(st.fontFamily) el.style.fontFamily = st.fontFamily;
      if(st.color) el.style.color = st.color;
      if(st.fontStyle) el.style.fontStyle = st.fontStyle;
      if(st.fontWeight) el.style.fontWeight = st.fontWeight;
      if(st.align) el.style.textAlign = st.align;
      if(st.lineHeight) el.style.lineHeight = st.lineHeight;
    };
    if(rich){
      applyText(nameEl, b.name || { x:4, y:10 });
      applyText(textEl, b.text || { x:4, y:32 });
    }
    const ch = this.el.choices;
    ch.style.left = (c.left != null ? c.left : 50) + '%';
    ch.style.top = (c.top != null ? c.top : 42) + '%';
    if(c.bg) ch.style.setProperty('--choice-bg', c.bg);
    if(c.color) ch.style.setProperty('--choice-color', c.color);
    if(c.radius != null) ch.style.setProperty('--choice-radius', c.radius + 'px');
    if(c.fontSize) ch.style.setProperty('--choice-fs', c.fontSize + 'px');
    if(c.gap != null) ch.style.gap = c.gap + 'px';
    ch.style.bottom = 'auto';
    ch.style.width = (c.width != null ? c.width : 56) + '%';
    ch.style.maxWidth = 'none';
    ch.style.transform = 'translateX(-50%)';

    // фон: узел / сцена / условные варианты (первый подходящий)
    let bg = '', bgFit = 'cover', bgPos = 'center';
    const sc = node.sceneId && this.scenes[node.sceneId] ? this.scenes[node.sceneId] : null;
    const variants = (node.bgVariants && node.bgVariants.length) ? node.bgVariants
      : (sc && sc.bgVariants && sc.bgVariants.length) ? sc.bgVariants : null;
    if(variants){
      let picked = null;
      for(const v of variants){
        if(this.check(v.condition)){ picked = v; break; }
      }
      if(!picked) picked = variants[variants.length - 1];
      if(picked){
        bg = picked.bg || picked.src || '';
        bgFit = picked.bgFit || sc && sc.bgFit || 'cover';
        bgPos = picked.bgPos || sc && sc.bgPos || 'center';
      }
    }
    if(!bg){
      bg = node.bg || (sc && sc.bg) || '';
      bgFit = node.bgFit || (sc && sc.bgFit) || 'cover';
      bgPos = node.bgPos || (sc && sc.bgPos) || 'center';
    }
    applyStageBg(this.el.stage, bg, bgFit, bgPos);
    const activeIds = new Set();
    const IN_MAP = { fade:'in-fade', 'slide-left':'in-slide-left', 'slide-right':'in-slide-right', 'slide-up':'in-slide-up', 'slide-down':'in-slide-down' };
    const OUT_MAP = { fade:'out-fade', 'slide-left':'out-slide-left', 'slide-right':'out-slide-right', 'slide-up':'out-slide-up', 'slide-down':'out-slide-down' };
    (node.sprites||[]).forEach(s=>{
      if(s.hide || !this.check(s.condition)) return;
      activeIds.add(s.id);
      let d = this.spriteState[s.id];
      const wasVisible = d && d.classList.contains('show') && !d.classList.contains('is-leaving');
      if(!d){ d = document.createElement('div'); this.el.sprites.appendChild(d); this.spriteState[s.id] = d; }
      let px, py;
      if(s.x != null && s.y != null){
        px = Number(s.x); py = Number(s.y);
      } else {
        const xy = slotXY(s.pos || 'bottom');
        px = xy.x; py = xy.y;
      }
      const floor = isFloorAnchor(s.pos, py);
      const sc = (s.scale != null ? Number(s.scale) : 100) / 100;
      d.style.setProperty('--sx', String(sc));
      d.style.right = 'auto';
      d.style.left = px + '%';
      d.style.bottom = py + '%';
      if(s.src){
        d.innerHTML = '';
        const im = document.createElement('img');
        im.alt = '';
        im.src = s.src;
        if(im.decode) im.decode().catch(()=>{});
        d.appendChild(im);
      } else {
        d.textContent = s.emoji || '🙂';
      }
      d.className = 'sprite' + (floor ? ' floor' : '');
      d.classList.remove('is-leaving');
      d.style.animation = '';
      d.style.opacity = '';
      if(floor){
        d.style.transformOrigin = 'center bottom';
        d.style.transform = 'translateX(-50%) scale(var(--sx))';
      } else {
        d.style.transformOrigin = 'center center';
        d.style.transform = 'translate(-50%, 50%) scale(var(--sx))';
      }
      d.dataset.animOut = s.animOut || s.anim || 'fade';
      const enter = (s.anim || s.animIn || 'fade');
      const inCls = IN_MAP[enter] || (enter === 'none' ? '' : 'in-fade');
      if(!wasVisible){
        void d.offsetWidth;
        if(inCls) d.classList.add(inCls);
        d.classList.add('show');
      } else {
        d.classList.add('show');
      }
    });
    Object.keys(this.spriteState).forEach(sid=>{
      if(activeIds.has(sid)) return;
      const d = this.spriteState[sid];
      if(!d || d.classList.contains('is-leaving')) return;
      if(!d.classList.contains('show')){
        d.className = 'sprite'; d.style.opacity = '0'; d.innerHTML = '';
        return;
      }
      // find exit anim from previous node data if stored on element
      const exit = d.dataset.animOut || 'fade';
      const outCls = OUT_MAP[exit];
      const finish = () => {
        d.className = 'sprite';
        d.style.opacity = '0';
        d.style.animation = 'none';
        d.innerHTML = '';
        d.classList.remove('is-leaving');
        d.removeEventListener('animationend', finish);
      };
      if(!outCls || exit === 'none'){
        finish();
        return;
      }
      d.classList.add('is-leaving');
      d.classList.remove('in-fade','in-slide-left','in-slide-right','in-slide-up','in-slide-down');
      void d.offsetWidth;
      d.classList.add(outCls);
      d.addEventListener('animationend', finish);
      setTimeout(finish, 500);
    });
    // store animOut on visible sprites for next hide
    (node.sprites||[]).forEach(s=>{
      if(s.hide || !this.check(s.condition)) return;
      const d = this.spriteState[s.id];
      if(d) d.dataset.animOut = s.animOut || s.anim || 'fade';
    });
    this.el.name.textContent = node.speaker || '';
    this.el.box.classList.toggle('narration', node.type === 'narration');
    this.el.choices.style.display = 'none'; this.el.choices.innerHTML = '';
    this._displayText = this.resolveText(node);
    this.typeText(this._displayText);
    const visibleChoices = (node.choices||[]).filter(c => this.check(c.condition));
    if(visibleChoices.length){
      setTimeout(()=>{
        this.el.choices.style.display = 'flex';
        visibleChoices.forEach(c=>{
          const b = document.createElement('button');
          b.className='choice'; b.textContent=c.label;
          b.onclick=(e)=>{ e.stopPropagation(); if(c.sfx) AudioBus.playSfx(this.resolveAudio(c.sfx), c.sfxVol); this.applyEffects(c.effects); this.goto(c.next); };
          this.el.choices.appendChild(b);
        });
      }, 300);
    }
  }
  typeText(str){
    str = str == null ? '' : String(str);
    this.typing = true;
    clearInterval(this._t);
    this._t = null;
    this.el.text.textContent = '';
    let i = 0;
    this._t = setInterval(()=>{
      if(i >= str.length){
        clearInterval(this._t);
        this._t = null;
        this.el.text.textContent = str;
        this.typing = false;
        return;
      }
      this.el.text.textContent = str.slice(0, ++i);
    }, 18);
  }
  finishTyping(){ clearInterval(this._t); this.el.text.textContent = this._displayText || ''; this.typing = false; }
}

const script = [
  { id:'start', bg:'#1c2b3a', type:'narration',
    text:'Дождь стучит по крыше вокзала. Через минуту прибудет последний поезд.', next:'arrive' },
  { id:'arrive', bg:'#1c2b3a', sprites:[{id:'yuki', emoji:'🧑\u200d🎓', pos:'right'}],
    speaker:'', text:'На платформе появляется фигура — это Юки.', next:'meet' },
  { id:'meet', speaker:'Юки', text:'Ты тоже опоздала на автобус?', next:'reply' },
  { id:'reply', speaker:'', text:'Что вы ответите?', choices:[
      {label:'«Да, ужасно не повезло»', next:'friendly'}, {label:'Промолчать и отвернуться', next:'cold'} ]},
  { id:'friendly', speaker:'Юки', text:'Ха, значит не только мне сегодня не везёт.', next:'end' },
  { id:'cold', speaker:'Юки', text:'...Ладно, извини за вопрос.', next:'end' },
  { id:'end', sprites:[{id:'yuki', hide:true}], speaker:'', text:'— Конец демо-сцены —' },
];

let engine = null;
const loadBtn = document.getElementById('loadBtn');
const loadPanel = document.getElementById('loadPanel');
const loadArea = document.getElementById('loadArea');
loadBtn.addEventListener('click', () => { loadPanel.style.display = 'flex'; });
document.getElementById('cancelBtn').addEventListener('click', () => { loadPanel.style.display = 'none'; });
document.getElementById('runBtn').addEventListener('click', async () => {
  try{
    const data = JSON.parse(loadArea.value);
    loadPanel.style.display = 'none';
    await startGame(data);
  } catch(e){ alert('Ошибка в JSON: ' + e.message); }
});
// demo boot with preload
const __isPreview = /(?:\?|&)preview=1(?:&|$)/.test(location.search) || (window.parent && window.parent !== window);
if(__isPreview){
  try { hideBoot(); } catch(_){}
  const ov = document.getElementById('bootOverlay');
  if(ov){
    ov.style.display = 'none';
    ov.classList.remove('show', 'hidden');
  }
}
if (!window.__VN_PROJECT_ID__ && !__isPreview) startGame(script);
// в режиме preview ждём postMessage от редактора


const EDITOR_HTML_B64 = "";
</script>
</body>
</html>
